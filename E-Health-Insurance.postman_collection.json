            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": null,\n  \"message\": \"What does my plan cover?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/ai/chatbot", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ai", "chatbot"] },
            "description": "Pass sessionId: null to start a new chat; reuse the captured {{sessionId}} to continue. Scoped to e-health insurance topics only."
          }
        },
        {
          "name": "Continue chat (uses sessionId)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"And what is the yearly premium?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/ai/chatbot", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ai", "chatbot"] }
          }
        },
        {
          "name": "Get chat history (CUSTOMER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/chatbot/history?sessionId={{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "chatbot", "history"],
              "query": [{ "key": "sessionId", "value": "{{sessionId}}" }]
            }
          }
        }
      ]
