            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/policies", "host": ["{{baseUrl}}"], "path": ["api", "v1", "policies"] },
            "description": "Rejected if the user already has an ACTIVE or PENDING policy. Responds PENDING; payment + activation happen asynchronously (~2s)."
          }
        },
        {
          "name": "List my policies (CUSTOMER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
