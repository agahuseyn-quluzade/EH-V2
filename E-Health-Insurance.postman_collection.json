                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/payments/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "me"] }
          }
        },
