                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/policies/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "policies", "me"] }
          }
        },
        {
          "name": "Get policy by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/policies/{{policyId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "policies", "{{policyId}}"] }
          }
        },
        {
          "name": "Cancel policy",
          "request": {
            "method": "PUT",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/policies/{{policyId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "v1", "policies", "{{policyId}}", "cancel"] }
          }
        },
        {
          "name": "List all policies (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/policies?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "policies"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Claims",
      "item": [
        {
          "name": "Submit claim (CUSTOMER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.data) pm.collectionVariables.set('claimId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyId\": \"{{policyId}}\",\n  \"claimType\": \"CONSULTATION\",\n  \"amount\": 250.00,\n  \"description\": \"Doctor visit\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/claims", "host": ["{{baseUrl}}"], "path": ["api", "v1", "claims"] },
            "description": "claimType: HOSPITALIZATION | MEDICATION | DENTAL | CONSULTATION. AI auto-scores: <40 APPROVED, 40-69 UNDER_REVIEW, >=70 REJECTED."
          }
        },
        {
          "name": "List my claims (CUSTOMER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/claims/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "claims", "me"] }
          }
        },
        {
          "name": "Get claim by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/claims/{{claimId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "claims", "{{claimId}}"] }
          }
        },
        {
          "name": "Upload claim evidence",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": { "raw": "{{baseUrl}}/api/v1/claims/{{claimId}}/evidence", "host": ["{{baseUrl}}"], "path": ["api", "v1", "claims", "{{claimId}}", "evidence"] },
            "description": "multipart/form-data with field 'file'. Select a file in the Body tab before sending."
          }
        },
        {
          "name": "List all claims (STAFF/ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/claims?status=UNDER_REVIEW&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "claims"],
              "query": [
                { "key": "status", "value": "UNDER_REVIEW", "description": "optional: SUBMITTED|UNDER_REVIEW|APPROVED|REJECTED" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Review claim (STAFF/ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVED\",\n  \"approvedAmount\": 250.00,\n  \"rejectionReason\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/claims/{{claimId}}/review", "host": ["{{baseUrl}}"], "path": ["api", "v1", "claims", "{{claimId}}", "review"] },
            "description": "decision: APPROVED | REJECTED. Only works on UNDER_REVIEW claims."
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Process payment (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"referenceId\": \"{{policyId}}\",\n  \"referenceType\": \"POLICY_PREMIUM\",\n  \"amount\": 1200\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payments/process", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "process"] },
            "description": "referenceType: POLICY_PREMIUM | CLAIM_PAYOUT. Normally driven by Kafka events, not direct calls."
          }
        },
        {
          "name": "List my payments (CUSTOMER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
