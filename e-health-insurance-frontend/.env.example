# Frontend (Vite) config. Copy to `.env` for local dev.
# NOTE: these are baked into the public client bundle at build time — they are
# NOT secrets. Never put API keys, tokens or passwords in this file.

# API gateway origin. Dev: vite proxies /api here. Prod build: public gateway URL.
VITE_GATEWAY_URL=http://localhost:8080

# Set to "true" to use the in-memory mock backend (no real services needed).
VITE_USE_MOCKS=false
