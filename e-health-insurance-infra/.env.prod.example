# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment template.
#
#   cp .env.prod.example .env.prod      # then fill in REAL secrets
#   docker compose -f docker-compose.yaml -f docker-compose.prod.yaml \
#       --env-file .env.prod up -d
#
# NEVER commit the filled-in .env.prod (it is git-ignored). In a real cluster,
# inject these through your secret manager (Vault / AWS Secrets Manager / SSM /
# Kubernetes Secrets) rather than a flat file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core secrets ─────────────────────────────────────────────────────────────
# Base64 HMAC key, 32+ bytes:  openssl rand -base64 48
JWT_SECRET=
# MUST differ from JWT_SECRET in production:  openssl rand -base64 48
GATEWAY_HEADER_SECRET=
# Postgres superuser password (username defaults to "ehi"):  openssl rand -base64 32
POSTGRES_PASSWORD=
# Redis AUTH password:  openssl rand -base64 32
REDIS_PASSWORD=
# Grafana admin password (login form is enabled in prod)
GRAFANA_ADMIN_PASSWORD=

# ── AI provider ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash

# ── SMTP relay (notification prod profile — MailHog is NOT used in prod) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# ── Observability ────────────────────────────────────────────────────────────
# Lower trace sampling in prod to control overhead/cost (0.0–1.0).
TRACING_SAMPLE_RATE=0.1
# Prometheus on-disk retention.
PROM_RETENTION=15d

# ── Gateway rate limiting (token bucket: replenish=tokens/sec, burst=bucket) ──
RATE_LIMIT_LOGIN_REPLENISH_RATE=5
RATE_LIMIT_LOGIN_BURST_CAPACITY=10
RATE_LIMIT_REGISTER_REPLENISH_RATE=2
RATE_LIMIT_REGISTER_BURST_CAPACITY=5
RATE_LIMIT_PASSWORD_RESET_REPLENISH_RATE=2
RATE_LIMIT_PASSWORD_RESET_BURST_CAPACITY=4
RATE_LIMIT_PAYMENT_REPLENISH_RATE=5
RATE_LIMIT_PAYMENT_BURST_CAPACITY=10
RATE_LIMIT_CLAIM_SUBMIT_REPLENISH_RATE=3
RATE_LIMIT_CLAIM_SUBMIT_BURST_CAPACITY=6
RATE_LIMIT_DEFAULT_REPLENISH_RATE=50
RATE_LIMIT_DEFAULT_BURST_CAPACITY=100

# ── IAM token TTLs / auth-email links (point at the real frontend origin) ─────
PASSWORD_RESET_TOKEN_TTL=15m
EMAIL_VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_LINK_URL=https://app.example.com/reset-password
EMAIL_VERIFICATION_LINK_URL=https://app.example.com/verify-email

# ── Kafka sizing ─────────────────────────────────────────────────────────────
# Single-broker defaults are for local only. In prod point KAFKA_BOOTSTRAP_SERVERS
# at your managed cluster and raise replication for durability.
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=3
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g
OUTBOX_PUBLISHER_ENABLED=true

# Topic names default to the values in .env.example; override only if your
# cluster uses a different naming convention.
