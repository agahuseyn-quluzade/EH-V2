# Base64-encoded HMAC key, 32+ bytes. Example: openssl rand -base64 48
JWT_SECRET=

# Gateway identity-header signing secret. Use a different value from JWT_SECRET in production.
GATEWAY_HEADER_SECRET=

# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model id.
LLM_MODEL=google/gemini-2.5-flash

# Redis auth. Example: openssl rand -base64 32
REDIS_PASSWORD=

# Kafka single-broker local defaults. Increase only when the broker count changes.
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m

# Kafka topic names. Override these only through env/config, not in code.
PAYMENT_INITIATED_TOPIC=payment.initiated
PAYMENT_SUCCEEDED_TOPIC=payment.succeeded
PAYMENT_FAILED_TOPIC=payment.failed
PAYMENT_REFUNDED_TOPIC=payment.refunded
POLICY_PURCHASE_REQUESTED_TOPIC=policy.purchase.requested
POLICY_ACTIVATED_TOPIC=policy.activated
POLICY_CANCELLED_TOPIC=policy.cancelled
CLAIM_SUBMITTED_TOPIC=claim.submitted
CLAIM_REVIEW_REQUIRED_TOPIC=claim.review.required
CLAIM_APPROVED_TOPIC=claim.approved
CLAIM_REJECTED_TOPIC=claim.rejected
NOTIFICATION_EMAIL_REQUESTED_TOPIC=notification.email.requested
HEALTH_RECORD_CREATED_TOPIC=health-record.created
HEALTH_RECORD_UPDATED_TOPIC=health-record.updated
AUDIT_EVENT_CREATED_TOPIC=audit.event.created

# Kafka DLQ topic names. Outbox publishers use "<topic>.dlq" by default.
PAYMENT_INITIATED_DLQ_TOPIC=payment.initiated.dlq
PAYMENT_SUCCEEDED_DLQ_TOPIC=payment.succeeded.dlq
PAYMENT_FAILED_DLQ_TOPIC=payment.failed.dlq
PAYMENT_REFUNDED_DLQ_TOPIC=payment.refunded.dlq
POLICY_PURCHASE_REQUESTED_DLQ_TOPIC=policy.purchase.requested.dlq
POLICY_ACTIVATED_DLQ_TOPIC=policy.activated.dlq
POLICY_CANCELLED_DLQ_TOPIC=policy.cancelled.dlq
CLAIM_SUBMITTED_DLQ_TOPIC=claim.submitted.dlq
CLAIM_REVIEW_REQUIRED_DLQ_TOPIC=claim.review.required.dlq
CLAIM_APPROVED_DLQ_TOPIC=claim.approved.dlq
CLAIM_REJECTED_DLQ_TOPIC=claim.rejected.dlq
NOTIFICATION_EMAIL_REQUESTED_DLQ_TOPIC=notification.email.requested.dlq
HEALTH_RECORD_CREATED_DLQ_TOPIC=health-record.created.dlq
HEALTH_RECORD_UPDATED_DLQ_TOPIC=health-record.updated.dlq
AUDIT_EVENT_CREATED_DLQ_TOPIC=audit.event.created.dlq

# Outbox publisher switch for Docker services that produce Kafka events.
OUTBOX_PUBLISHER_ENABLED=true

# Notification service local profile uses Mailhog by default. Use prod profile
# with SMTP_* values for production deployments.
NOTIFICATION_SPRING_PROFILE=local
NOTIFICATION_EMAIL_CONSUMER_GROUP=notification-service-email
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=3
NOTIFICATION_DELIVERY_RETRY_DELAY_MS=120000
NOTIFICATION_DELIVERY_DLQ_ENABLED=true
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Policy consumer for payment lifecycle events.
POLICY_PAYMENT_EVENTS_ENABLED=true
POLICY_PAYMENT_CONSUMER_GROUP=policy-service-payment-events

# Payment idempotency cache TTLs.
PAYMENT_IDEMPOTENCY_TTL_SECONDS=86400
PAYMENT_IDEMPOTENCY_LOCK_TTL_SECONDS=300

# IAM auth email events (password reset / email verification via notification service).
IAM_EVENTS_ENABLED=true

# One-time token TTLs stored in Redis (Spring Duration format: 15m, 24h).
PASSWORD_RESET_TOKEN_TTL=15m
EMAIL_VERIFICATION_TOKEN_TTL=24h

# Links embedded into auth emails (frontend routes).
PASSWORD_RESET_LINK_URL=http://localhost:5173/reset-password
EMAIL_VERIFICATION_LINK_URL=http://localhost:5173/verify-email

# Gateway Redis rate limiting (token bucket: replenish = tokens/sec, burst = bucket size).
# Sensitive endpoints have dedicated limits; everything else uses the default.
RATE_LIMIT_LOGIN_REPLENISH_RATE=5
RATE_LIMIT_LOGIN_BURST_CAPACITY=10
RATE_LIMIT_REGISTER_REPLENISH_RATE=2
RATE_LIMIT_REGISTER_BURST_CAPACITY=5
RATE_LIMIT_PASSWORD_RESET_REPLENISH_RATE=2
RATE_LIMIT_PASSWORD_RESET_BURST_CAPACITY=4
RATE_LIMIT_PAYMENT_REPLENISH_RATE=5
RATE_LIMIT_PAYMENT_BURST_CAPACITY=10
RATE_LIMIT_CLAIM_SUBMIT_REPLENISH_RATE=3
RATE_LIMIT_CLAIM_SUBMIT_BURST_CAPACITY=6
RATE_LIMIT_DEFAULT_REPLENISH_RATE=50
RATE_LIMIT_DEFAULT_BURST_CAPACITY=100
