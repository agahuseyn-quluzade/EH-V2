# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.
OPENROUTER_API_KEY=

# Payment provider: mock (default) or epoint
PAYMENT_PROVIDER=mock
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_SUCCESS_REDIRECT_URL=http://localhost:5173/payments/success
EPOINT_ERROR_REDIRECT_URL=http://localhost:5173/payments/error

# AWS notifications (SES email + SNS SMS)
AWS_ENABLED=false
AWS_REGION=eu-central-1
AWS_SES_FROM=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# JWT signing secret — REQUIRED in production, must be a strong 256-bit value.
JWT_SECRET=
